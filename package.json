{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "hc-brain",
    "private": true,
    "type": "module",
    "description": "HC Brain — cérebro da empresa: backend Laravel e telas em TypeScript",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write resources/css resources/js",
        "format:check": "prettier --check resources/css resources/js"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.4.2",
        "typescript": "^5.7.2",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.1.1",
        "lucide": "^1.48.0"
    }
}
